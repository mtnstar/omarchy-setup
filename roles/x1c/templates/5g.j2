#!/bin/bash
cmd=${1:-status}

modem_index() {
  mmcli -L 2>/dev/null | grep -oP '/org/freedesktop/ModemManager1/Modem/\K[0-9]+' | head -1
}

wait_for_modem() {
  local retries=15
  local idx
  for ((i=1; i<=retries; i++)); do
    idx=$(modem_index)
    [[ -n "$idx" ]] && { echo "$idx"; return 0; }
    echo "Waiting for modem... ($i/$retries)"
    sleep 1
  done
  echo "No modem found after ${retries}s" >&2
  return 1
}

case "$cmd" in
  connect|c)
    apn=${2:-{{ wwan_apn | default('GPRS.SWISSCOM.CH') }}}
    idx=$(wait_for_modem) || exit 1
    echo "Connecting (APN: $apn)..."
    mmcli -m "$idx" --simple-connect="apn=$apn"
    ;;
  disconnect|d)
    idx=$(wait_for_modem) || exit 1
    mmcli -m "$idx" --simple-disconnect
    ;;
  status)
    idx=$(wait_for_modem) || exit 1
    mmcli -m "$idx"
    ;;
  *)
    echo "Usage: 5g {connect|c [apn]|disconnect|d|status}"
    exit 1
    ;;
esac
